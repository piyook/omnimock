{
	"type": "module",
	"version": "3.0.11",
	"name": "mock-api-server",
	"description": "A mock API server for development and testing purposes.",
	"author": "piyook",
	"scripts": {
		"dev": "tsx watch ./src/server.ts",
		"start": "docker compose up -d",
		"stop": "docker compose down --volumes",
		"rebuild": "docker compose down --volumes && docker compose up -d --force-recreate --build",
		"restart": "npm stop && npm start",
		"torch": "torch-it",
		"prepare": "husky || true",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "node scripts/run-e2e.mjs",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run --e2e",
		"validate-branch-name": "node scripts/validate-branch-name.mjs",
		"mcp:build": "tsc ./src/mcp/server.ts --target esnext --moduleResolution nodenext --module nodenext",
		"mcp:debug": "npx @modelcontextprotocol/inspector node ./src/mcp/server.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@types/chai-json-schema": "^1.4.10",
		"@types/markdown-it": "^14.2.0",
		"chai-json-schema": "^2.0.1",
		"dotenv": "^18.0.6",
		"fastify": "^5.12.5",
		"highlight.js": "^11.12.0",
		"markdown-it": "^15.0.2",
		"pretty-print-json": "^3.0.8",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/aws-lambda": "^8.10.164",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^5.0.3",
		"cypress": "^16.1.1",
		"fallow": "3.31.0",
		"husky": "^9.1.7",
		"torch-it": "^2.6.2",
		"vitest": "^5.0.3"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"allowScripts": {
		"cypress": true,
		"esbuild": true
	}
}
