{
	"type": "module",
	"version": "4.2.0",
	"name": "mock-api-server",
	"description": "A mock API server for development and testing purposes.",
	"author": "piyook",
	"scripts": {
		"postinstall": "node scripts/postinstall.mjs",
		"dev": "(npm run compile-ui || echo Dashboard build failed - starting the server without it) && npm run dev:server",
		"dev:server": "tsx watch ./src/server.ts",
		"ui-dev": "npm --prefix ui run dev",
		"compile-ui": "npm --prefix ui run build",
		"start": "docker compose up -d",
		"stop": "docker compose down --volumes",
		"rebuild": "docker compose down --volumes && docker compose up -d --force-recreate --build",
		"restart": "npm stop && npm start",
		"torch": "torch-it",
		"prepare": "husky || true",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npm run compile-ui && node scripts/run-e2e.mjs",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run --e2e",
		"validate-branch-name": "node scripts/validate-branch-name.mjs",
		"mcp:build": "tsc ./src/mcp/server.ts --ignoreConfig --target esnext --moduleResolution nodenext --module nodenext",
		"mcp:debug": "npx @modelcontextprotocol/inspector node ./src/mcp/server.js",
		"typecheck": "tsc --noEmit && npm --prefix ui run check",
		"audit": "npm audit --omit=dev && npm --prefix ui audit --omit=dev"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@types/chai-json-schema": "^1.4.10",
		"@types/markdown-it": "^14.2.0",
		"chai-json-schema": "^2.0.1",
		"dotenv": "^18.0.9",
		"fastify": "^5.12.8",
		"highlight.js": "^11.12.0",
		"markdown-it": "^15.0.3",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/aws-lambda": "^8.10.164",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.1.0",
		"cypress": "^16.2.1",
		"fallow": "3.40.0",
		"husky": "^9.1.7",
		"torch-it": "^3.0.1",
		"vitest": "^5.1.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"allowScripts": {
		"cypress": true,
		"esbuild": true
	}
}
