PROJECT_NAME=mock-api-framework
SERVER_PORT=8000
USE_API_URL_PREFIX=api
LOG_REQUESTS=ON
DELETE_LOGS_ON_SERVER_RESTART=ON
# Chaos mode: fail some calls to the mock endpoints with an HTTP error
CHAOS_ENABLED=OFF
# Fail 1 in this many calls (1 = every call)
CHAOS_FREQUENCY=5
# every (each Nth call) or random (a 1 in N chance per call)
CHAOS_MODE=every
# HTTP status of the error (400 to 599)
CHAOS_STATUS=500
# How many requests the log keeps (1 to 100)
MAX_LOGGED_REQUESTS=10
