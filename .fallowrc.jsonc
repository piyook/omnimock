{
	"$schema": "./node_modules/fallow/schema.json",
	// Each folder in src/api is loaded by name at start-up (file-scan.ts), the
	// MCP server is started on its own, and the templates are copied by hand
	// into src when a new endpoint or model is added.
	"entry": ["src/api/*/api.ts", "src/mcp/server.ts", "templates/**/*.ts"]
}
